# CampusIQ API Configuration
PROJECT_NAME="CampusIQ API"
VERSION="1.0.0"

# Supabase Managed Database & Storage Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Security
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"

# LLM & Embedding Secrets
GEMINI_API_KEY="your-gemini-2.5-flash-api-key"

# CORS Security (Vercel Frontend Domain)
ALLOWED_ORIGIN="https://campusiq.vercel.app"
